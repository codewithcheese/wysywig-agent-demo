# LLM Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Default provider and model
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview

# Optional: Visual diff settings
VISUAL_DIFF_ENABLED=false
VISUAL_DIFF_THRESHOLD=0.05

# Optional: Benchmark settings
BENCH_PARALLEL=1
BENCH_RETRY_REPAIR=true
